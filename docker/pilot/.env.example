# Copy outside Git, chmod 600; fill every blank. Never put real values here.
# Run: node --env-file=/absolute/private/pilot.env scripts/pilot-check-env.mjs
NODE_ENV=production
SERVICE_VERSION=[FILL: reviewed commit/image revision]
ADMIN_PORT=3000
APP_BASE_URL=https://[FILL: app hostname]
LMC_PUBLIC_BASE_URL=https://[FILL: same app hostname]
LMC_EMAIL_FROM=[FILL: verified sending address]
LMC_RECEIVING_DOMAIN=[FILL: verified inbound subdomain]
GOOGLE_REDIRECT_URI=https://[FILL: app hostname]/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# Generate a DIFFERENT 32-byte hex value for EVERY line below (openssl rand -hex 32).
POSTGRES_PASSWORD=
LOBBYSTACK_MIGRATOR_PASSWORD=
LOBBYSTACK_AUTH_PASSWORD=
LOBBYSTACK_APP_PASSWORD=
LOBBYSTACK_SYSTEM_PASSWORD=
LOBBYSTACK_WORKER_PASSWORD=
LOBBYSTACK_DISPATCHER_PASSWORD=
LOBBYSTACK_READONLY_PASSWORD=
BETTER_AUTH_SECRET=
INTERNAL_SERVICE_SECRET=
INTERNAL_SERVICE_TOKEN=
WIDGET_SESSION_SECRET=
